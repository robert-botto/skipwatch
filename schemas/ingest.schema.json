        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ms": {
          "default": 0,
          "title": "Ms",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "enum": [
                "useful",
                "partly",
                "not_useful",
                "not_sure"
