  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/IngestContext",
      "default": {
        "author_replies": [],
        "captions_available": false,
        "captions_kind": null,
        "captions_lang": null,
        "captions_path": null,
        "links": [],
        "post_text": null,
        "thread": []
      }
    },
    "fetched_with_cookies": {
      "default": false,
      "title": "Fetched With Cookies",
      "type": "boolean"
    },
    "from_cache": {
      "default": false,
      "title": "From Cache",
      "type": "boolean"
    },
    "media": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
