            "$ref": "#/$defs/LinkContext"
          },
          "title": "Links",
          "type": "array"
        },
        "post_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Text"
        },
        "thread": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Thread",
          "type": "array"
        }
      },
      "title": "IngestContext",
      "type": "object"
    },
    "LinkContext": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "maxLength": 20000,
          "title": "Text",
          "type": "string"
