            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captions Kind"
        },
        "captions_lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captions Lang"
        },
        "captions_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captions Path"
        },
        "links": {
          "default": [],
