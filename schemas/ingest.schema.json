    "provider_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderCall"
      },
      "title": "Provider Calls",
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/Route"
    },
    "schema": {
      "const": "skipwatch/ingest/1",
      "default": "skipwatch/ingest/1",
      "title": "Schema",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "transcript_hint": {
      "$ref": "#/$defs/TranscriptHint",
      "default": {
        "origin": "none",
        "text": null
      }
    }
  },
  "required": [
    "schema",
    "source",
    "route"
  ],
  "title": "IngestBundle",
  "type": "object"
}
